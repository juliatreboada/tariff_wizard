# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Private reference material (FIG sheets, federation PDFs, filled examples)
/reference/*
!/reference/README.example.md

/private/

# Personal learning notes (not for the deployed app)
/docs/learning/
/notes/
*.local.md

# Editor / local tooling (keep shared rules, ignore the rest)
.cursor/*
!.cursor/rules/
!.cursor/rules/**
.idea/
.vscode/settings.json

# OS / tooling noise
.turbo

